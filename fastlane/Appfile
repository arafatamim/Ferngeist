# Play Console package + API credentials.
#
# The Google Play service-account JSON is a secret and is NOT committed. Provide it via:
#   - env var SUPPLY_JSON_KEY_FILE pointing at the file, or
#   - env var SUPPLY_JSON_KEY containing the raw JSON (CI-friendly), or
#   - a local file at the default path below (git-ignored).
json_key_file(ENV["SUPPLY_JSON_KEY_FILE"] || "fastlane/play-store-service-account.json")

package_name("com.tamimarafat.ferngeist")
